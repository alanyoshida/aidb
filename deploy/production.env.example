# Variáveis do portal de produção (deploy/docker-compose.production.yml).
# Copie para deploy/production.env, preencha e NUNCA versione o arquivo preenchido.
#
#   docker compose -f deploy/docker-compose.production.yml --env-file deploy/production.env up -d --build

# --- obrigatórias (o compose recusa subir sem elas) ---
# openssl rand -hex 32
APPAIFORGE_SECRET_KEY=
# openssl rand -hex 32
APPAIFORGE_DB_GATE_PROXY_SERVICE_TOKEN=
# openssl rand -hex 16
APPAIFORGE_POSTGRES_PASSWORD=

# --- primeiro admin (admin de emergência) ---
APPAIFORGE_BREAKGLASS_EMAIL=admin@exemplo.com
# saída de: cd portal && uv run appaiforge hash-password
# entre aspas simples: o hash tem "$", que o compose interpretaria como variável
APPAIFORGE_BREAKGLASS_PASSWORD_HASH=''

# --- endereços ---
# como o navegador vê o portal (redirects do login)
APPAIFORGE_PUBLIC_BASE_URL=https://aidb-prod.exemplo.com
# como o GitLab vê o portal (aba Implantação → webhook); vazio = PUBLIC_BASE_URL
APPAIFORGE_WEBHOOK_BASE_URL=
# porta do Traefik no host
APPAIFORGE_HTTP_PORT=80

# --- autenticação ---
# local (e-mail e senha) ou oidc; fixado no primeiro boot
APPAIFORGE_AUTH_MODE=local
APPAIFORGE_OIDC_ISSUER=
APPAIFORGE_OIDC_INTERNAL_BASE_URL=
APPAIFORGE_OIDC_CLIENT_ID=
APPAIFORGE_OIDC_CLIENT_SECRET=

# --- implantação (opcionais) ---
APPAIFORGE_DEPLOY_POLL_INTERVAL=60
APPAIFORGE_DEPLOY_HEALTH_TIMEOUT=90
APPAIFORGE_DEPLOY_HEALTH_INTERVAL=2

# --- diretórios no host (opcionais) ---
APPAIFORGE_WORKSPACES_DIR=/opt/aidb-prod/workspaces
APPAIFORGE_CONFIGS_DIR=/opt/aidb-prod/configs
